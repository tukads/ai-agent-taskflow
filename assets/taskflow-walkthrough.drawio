<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Session continuity" id="continuity">
    <mxGraphModel grid="1" page="1" pageWidth="960" pageHeight="1030" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="TaskFlow: the session stops. The work keeps its place." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=28;fontFamily=Helvetica;spacing=18;align=left;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="900" height="76" />
        </mxCell>
        <mxCell id="start" value="1  TASK STARTS&#10;&#10;Record the goal and begin work." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DBEAFE;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=23;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="125" width="820" height="118" />
        </mxCell>
        <mxCell id="save" value="2  PROGRESS SAVED&#10;&#10;Persist completed steps, result references and next action." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=23;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="275" width="820" height="118" />
        </mxCell>
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="save">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="stop" value="3  SESSION INTERRUPTED&#10;&#10;Execution stops; the saved state remains on disk." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FEE2E2;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=23;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="425" width="820" height="118" />
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="save" target="stop">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="read" value="4  NEW SESSION READS STATE&#10;&#10;Load the snapshot and relevant result artifacts." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDE9FE;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=23;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="575" width="820" height="118" />
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stop" target="read">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="resume" value="5  CHECK OUTCOMES, THEN CONTINUE&#10;&#10;Verify what actually finished. Continue or retry only as needed;&#10;record the next progress update." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=23;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="725" width="820" height="118" />
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="resume">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="boundary" value="Saved state enables a deliberate handoff—not automatic execution recovery.&#10;Check external outcomes before retrying to avoid repeating completed actions." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=22;fontFamily=Helvetica;spacing=18;align=left;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="885" width="900" height="106" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>